{
  "expo": {
    "name": "Rotina Estrat\u00e9gica",
    "slug": "controle-de-habitos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060817"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rafael.controledehabitos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060817"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-screen-orientation"
    ],
    "extra": {
      "eas": {
        "projectId": "c35ef305-3ef0-4e9a-86bd-2abd983cd01e"
      }
    }
  }
}
